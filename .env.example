# ---- Django ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_ADMIN_URL=django-admin/
TIME_ZONE=Asia/Tashkent
LOG_LEVEL=INFO
# Set to 1 when the site is served over HTTPS (secure cookies, HSTS)
HTTPS=0

# ---- First admin (created on first start if it does not exist) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-Strong-Pass-123
ADMIN_EMAIL=

# ---- PostgreSQL ----
POSTGRES_DB=testplatform
POSTGRES_USER=testplatform
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# psycopg3 connection pool per Gunicorn process
DB_POOL=1
DB_POOL_MIN=2
DB_POOL_MAX=10

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ---- Gunicorn ----
WEB_CONCURRENCY=4
GUNICORN_THREADS=4

# ---- Exam rules ----
# Requests up to N seconds after the deadline are still accepted (slow networks)
EXAM_GRACE_SECONDS=20
# Max pause between stage 1 and stage 2 before the attempt is closed automatically
EXAM_STAGE_BREAK_MAX_MINUTES=15

# ---- Rate limits (DRF format: N/sec|min|hour) ----
THROTTLE_ATTEMPT_START=1000/min
THROTTLE_ATTEMPT_TOKEN=240/min
THROTTLE_ADMIN_LOGIN=10/min
# Number of reverse proxies in front of Django (nginx = 1)
NUM_PROXIES=1

# ---- Demo data: load branches/subjects/questions on first start ----
SEED_DEMO=1

# ---- Frontend / Docker ----
HTTP_PORT=8080
# Serve the built JS/CSS from a CDN, e.g. https://cdn.example.com/ (default "/")
VITE_PUBLIC_BASE=/
